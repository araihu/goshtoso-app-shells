package componentdocshell

import (
	"github.com/araihu/goshtoso/components/head"
	selectfield "github.com/araihu/goshtoso/components/select"
	"github.com/araihu/goshtoso/components/sidebar"
	shellassets "github.com/araihu/goshtoso-app-shells/componentdocshell/assets"
)

templ headTemplate(cfg Config) {
	@templ.Raw("<script>" + appearanceBootstrapScript(cfg) + "</script>")
	<script defer src={ shellassets.ScriptURL(cfg.assetPrefix()) }></script>
	if cfg.Interactions.LocalRuntime {
		@head.Dependencies(head.WithLocalRuntime())
	} else {
		@head.Dependencies()
	}
	for _, script := range cfg.Interactions.RuntimeScripts {
		<script src={ templ.SafeURL(script) }></script>
	}
	<link rel="stylesheet" href={ shellassets.StylesheetURL(cfg.assetPrefix()) }/>
	if !cfg.Appearance.DisableDefaultThemeStylesheet {
		<link rel="stylesheet" href={ shellassets.AraiHuThemeURL(cfg.assetPrefix()) }/>
	}
	for _, stylesheet := range cfg.Appearance.ThemeStylesheets {
		<link rel="stylesheet" href={ templ.SafeURL(stylesheet) }/>
	}
}

templ layoutTemplate(cfg Config, page Page, nav sidebar.Config) {
	<!doctype html>
	<html
		lang="en"
		x-data={ shellData(cfg) }
		x-on:componentdocshell:navigated.window="sidebarOpen = false"
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ currentPageTitle(cfg, page) }</title>
			if cfg.Brand.FaviconURL != "" {
				<link rel="icon" href={ templ.SafeURL(cfg.Brand.FaviconURL) }/>
			}
			if page.Description != "" {
				<meta name="description" content={ page.Description }/>
			}
			if page.CanonicalURL != "" {
				<link rel="canonical" href={ templ.SafeURL(page.CanonicalURL) }/>
			}
			if page.Head != nil {
				@page.Head
			}
			@Head(cfg)
		</head>
		<body class="component-doc-shell bg-surface text-on-surface dark:bg-surface-dark dark:text-on-surface-dark">
			<a class="component-doc-shell__skip sr-only focus:not-sr-only rounded-radius bg-primary px-3 py-2 text-on-primary" href="#main-content">Skip to content</a>
			<header class="component-doc-shell__header">
				<div class="component-doc-shell__header-inner">
					<div class="component-doc-shell__brand-group">
						<button class="component-doc-shell__menu-button" type="button" aria-label="Open navigation" x-bind:aria-label="sidebarOpen ? 'Close navigation' : 'Open navigation'" aria-controls="componentdocshell-sidebar" x-bind:aria-expanded="sidebarOpen" x-ref="sidebarTrigger" x-on:click="sidebarOpen = !sidebarOpen">
							@menuIcon()
						</button>
						<a class="component-doc-shell__brand" href={ templ.SafeURL(cfg.Brand.HomeURL) } aria-label={ cfg.Brand.Name + " home" }>
							if cfg.Brand.Logo != nil {
								@cfg.Brand.Logo
							} else {
								<span class="component-doc-shell__brand-mark" aria-hidden="true">{ string([]rune(cfg.Brand.Name)[0]) }</span>
							}
							<span class="component-doc-shell__brand-name">{ cfg.Brand.Name }</span>
						</a>
					</div>
					<div class="component-doc-shell__controls">
						if !cfg.Appearance.DisableThemeSelector {
							<div class="w-36 sm:w-44">
								@selectfield.Select(selectfield.Config{
									ID: cfg.themeSelectorID(),
									Name: "theme",
									Options: cfg.themes(),
									Alpine: &selectfield.AlpineConfig{Model: "theme"},
									TriggerAttrs: templ.Attributes{"aria-label": "Theme"},
								})
							</div>
						}
						if !cfg.Appearance.DisableDarkModeToggle {
							<button class="component-doc-shell__icon-button" id={ cfg.darkModeBinding().ButtonID } type="button" aria-label="Switch to dark mode" x-bind:aria-label={ cfg.darkModeAriaExpression() } x-on:click={ cfg.darkModeBinding().ToggleExpression }>
								<span x-show={ cfg.darkModeOffExpression() }>@moonIcon()</span>
								<span x-show={ cfg.darkModeBinding().StateExpression } x-cloak>@sunIcon()</span>
							</button>
						}
						if cfg.RepositoryURL != "" {
							<a class="component-doc-shell__icon-button component-doc-shell__repository" href={ templ.SafeURL(cfg.RepositoryURL) } target="_blank" rel="noreferrer" aria-label="Source repository">
								@repositoryIcon()
							</a>
						}
						if cfg.HeaderActions != nil {
							@cfg.HeaderActions
						}
					</div>
				</div>
			</header>
			<div class="component-doc-shell__frame">
				<div id="componentdocshell-sidebar" class="component-doc-shell__sidebar" x-bind:class="sidebarOpen ? 'is-open' : ''" x-trap.noscroll="sidebarOpen" x-on:keydown.escape.window="sidebarOpen = false; $nextTick(() => $refs.sidebarTrigger.focus())">
					@sidebarContent(nav, false)
				</div>
				<div class="component-doc-shell__backdrop" x-show="sidebarOpen" x-cloak x-on:click="sidebarOpen = false; $nextTick(() => $refs.sidebarTrigger.focus())"></div>
				<main id="page-scroll" class="component-doc-shell__main-scroll">
					<div class="component-doc-shell__content-frame">
						@pageContent(cfg, page, false)
						@tocRail(cfg, page)
					</div>
				</main>
			</div>
			if cfg.BodyEnd != nil {
				@cfg.BodyEnd
			}
		</body>
	</html>
}

templ sidebarContent(nav sidebar.Config, oob bool) {
	<div id="componentdocshell-sidebar-content" class="component-doc-shell__sidebar-content" { sidebarOOBAttributes(oob)... }>
		@sidebar.Sidebar(nav)
	</div>
}

templ pageContent(cfg Config, page Page, oob bool) {
	<div id="main-content" class="component-doc-shell__main" tabindex="-1" { mainOOBAttributes(oob)... }>
		@page.Content
		if cfg.Footer != nil {
			<footer class="component-doc-shell__footer">
				@cfg.Footer
			</footer>
		}
	</div>
}

templ tocRail(cfg Config, page Page) {
	<div id={ cfg.tocRailID() } class="component-doc-shell__toc" data-componentdocshell-toc data-enabled={ boolText(page.EnableTOC) } hidden?={ !page.EnableTOC }>
		<aside class="component-doc-shell__toc-inner" aria-label="On this page">
			<p class="component-doc-shell__toc-title">On this page</p>
			<nav id={ cfg.tocListID() } class="component-doc-shell__toc-list" data-componentdocshell-toc-list></nav>
		</aside>
	</div>
}

templ menuIcon() {
	<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="size-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
}

templ sunIcon() {
	<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="size-6"><circle cx="12" cy="12" r="4" stroke-width="1.5"></circle><path stroke-linecap="round" stroke-width="1.5" d="M12 2.25v1.5M12 20.25v1.5M21.75 12h-1.5M3.75 12h-1.5M18.9 5.1l-1.05 1.05M6.15 17.85 5.1 18.9M18.9 18.9l-1.05-1.05M6.15 6.15 5.1 5.1"></path></svg>
}

templ moonIcon() {
	<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="size-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 15A9.7 9.7 0 0 1 18 15.75 9.75 9.75 0 0 1 9 2.25 9.75 9.75 0 1 0 21.75 15Z"></path></svg>
}

templ repositoryIcon() {
	<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5"><path d="M12 0a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23A11.5 11.5 0 0 1 12 5.8c1.02 0 2.05.14 3 .4 2.3-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.82 1.1.82 2.22v3.3c0 .32.22.69.82.57A12 12 0 0 0 12 0Z"></path></svg>
}
