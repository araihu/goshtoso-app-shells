package landingshell

import (
	"github.com/araihu/goshtoso/components/head"
	shellassets "github.com/araihu/goshtoso-app-shells/landingshell/assets"
)

templ headTemplate(cfg Config) {
	@templ.Raw("<script>" + appearanceBootstrapScript(cfg) + "</script>")
	<script defer src={ shellassets.ScriptURL(cfg.assetPrefix()) }></script>
	if cfg.Interactions.LocalRuntime {
		@head.Dependencies(head.WithLocalRuntime())
	} else {
		@head.Dependencies()
	}
	<link rel="stylesheet" href={ shellassets.StylesheetURL(cfg.assetPrefix()) }/>
	for _, stylesheet := range cfg.Appearance.ThemeStylesheets {
		<link rel="stylesheet" href={ templ.SafeURL(stylesheet) }/>
	}
}

templ layoutTemplate(cfg Config, page Page) {
	<!doctype html>
	<html lang="en" data-theme={ cfg.defaultTheme() } x-data={ shellData(cfg) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ currentPageTitle(cfg, page) }</title>
			if page.Description != "" {
				<meta name="description" content={ page.Description }/>
			}
			if page.CanonicalURL != "" {
				<link rel="canonical" href={ templ.SafeURL(page.CanonicalURL) }/>
				<meta property="og:url" content={ page.CanonicalURL }/>
			}
			<meta property="og:type" content="website"/>
			<meta property="og:title" content={ currentPageTitle(cfg, page) }/>
			if page.Description != "" {
				<meta property="og:description" content={ page.Description }/>
			}
			if page.SocialImageURL != "" {
				<meta property="og:image" content={ page.SocialImageURL }/>
				<meta name="twitter:card" content="summary_large_image"/>
			}
			if cfg.Brand.FaviconURL != "" {
				<link rel="icon" href={ templ.SafeURL(cfg.Brand.FaviconURL) }/>
			}
			if page.Head != nil {
				@page.Head
			}
			@Head(cfg)
		</head>
		<body class="landing-shell bg-surface text-on-surface dark:bg-surface-dark dark:text-on-surface-dark">
			<a class="landing-shell__skip" href="#main-content">Skip to main content</a>
			<header class={ landingHeaderClass(cfg) }>
				<div class="landing-shell__container landing-shell__header-inner">
					<div class="landing-shell__brand-group">
						<a class="landing-shell__brand" href={ templ.SafeURL(cfg.Brand.HomeURL) } aria-label={ cfg.Brand.Name + " home" }>
							if cfg.Brand.Logo != nil {
								@cfg.Brand.Logo
							} else {
								<span class="landing-shell__brand-mark" aria-hidden="true">{ string([]rune(cfg.Brand.Name)[0]) }</span>
							}
							<span class="landing-shell__brand-copy">
								<strong>{ cfg.Brand.Name }</strong>
								if cfg.Brand.Tagline != "" {
									<small>{ cfg.Brand.Tagline }</small>
								}
							</span>
						</a>
						if cfg.Brand.Badge != nil && cfg.Brand.Badge.Label != "" {
							if cfg.Brand.Badge.Href != "" {
								<a class="landing-shell__brand-badge" href={ templ.SafeURL(cfg.Brand.Badge.Href) } aria-label={ cfg.Brand.Badge.AriaLabel }>{ cfg.Brand.Badge.Label }</a>
							} else {
								<span class="landing-shell__brand-badge" aria-label={ cfg.Brand.Badge.AriaLabel }>{ cfg.Brand.Badge.Label }</span>
							}
						}
					</div>
					<nav class="landing-shell__navigation" aria-label="Primary navigation">
						for _, item := range cfg.Navigation {
							@navigationLink(item)
						}
						if !cfg.Appearance.DisableDarkModeToggle {
							<button class="landing-shell__icon-button" id="landingshell-dark-mode" type="button" aria-label="Switch to dark mode" x-bind:aria-label="dark ? 'Switch to light mode' : 'Switch to dark mode'" x-on:click="toggleDark()">
								<span x-show="!dark">@moonIcon()</span>
								<span x-show="dark" x-cloak>@sunIcon()</span>
							</button>
						}
						if cfg.RepositoryURL != "" {
							<a class="landing-shell__icon-button" href={ templ.SafeURL(cfg.RepositoryURL) } target="_blank" rel="noopener noreferrer" aria-label="Source repository">@repositoryIcon()</a>
						}
						if cfg.HeaderActions != nil {
							@cfg.HeaderActions
						}
					</nav>
					if cfg.MobileNavigation != nil {
						@MobileNavigation(*cfg.MobileNavigation, mobileNavigationLinks(cfg))
					}
				</div>
			</header>
			<main id="main-content">
				<section class="landing-shell__hero"><div class="landing-shell__container landing-shell__hero-slot">@page.Hero</div></section>
				@page.Content
			</main>
			@landingFooter(cfg)
			if cfg.BodyEnd != nil {
				@cfg.BodyEnd
			}
		</body>
	</html>
}

templ mobileNavigationLinks(cfg Config) {
	for _, item := range cfg.Navigation {
		@navigationLink(item)
	}
}

templ navigationLink(item Link) {
	<a class={ navLinkClass(item) } href={ templ.SafeURL(item.Href) } if item.External { target="_blank" rel="noopener noreferrer" }>{ item.Label }</a>
}

templ landingFooter(cfg Config) {
	<footer class="landing-shell__footer">
		<div class="landing-shell__container landing-shell__footer-inner">
			<div class="landing-shell__footer-brand">
				if cfg.Footer.Logo != nil {
					@cfg.Footer.Logo
				} else if cfg.Brand.Logo != nil {
					@cfg.Brand.Logo
				}
				<p><strong>{ cfg.footerName() }</strong><br/><small>
					for index, item := range cfg.Footer.Meta {
						if index > 0 {
							<span aria-hidden="true"> · </span>
						}
						{ item }
					}
					if len(cfg.Footer.Meta) > 0 && cfg.Footer.Organization != nil {
						<span aria-hidden="true"> · </span>
					}
					if cfg.Footer.Organization != nil {
						an <a href={ templ.SafeURL(cfg.Footer.Organization.URL) } target="_blank" rel="noopener noreferrer">{ cfg.Footer.Organization.Name }</a> project
					}
				</small></p>
			</div>
			if len(cfg.Footer.Links) > 0 {
				<nav class="landing-shell__footer-links" aria-label="Footer navigation">
					for _, item := range cfg.Footer.Links {
						<a href={ templ.SafeURL(item.Href) } if item.External { target="_blank" rel="noopener noreferrer" }>{ item.Label }</a>
					}
				</nav>
			}
		</div>
	</footer>
}

templ sunIcon() {
	<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="4" stroke-width="1.5"></circle><path stroke-linecap="round" stroke-width="1.5" d="M12 2.25v1.5M12 20.25v1.5M21.75 12h-1.5M3.75 12h-1.5M18.9 5.1l-1.05 1.05M6.15 17.85 5.1 18.9M18.9 18.9l-1.05-1.05M6.15 6.15 5.1 5.1"></path></svg>
}

templ moonIcon() {
	<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 15A9.7 9.7 0 0 1 18 15.75 9.75 9.75 0 0 1 9 2.25 9.75 9.75 0 1 0 21.75 15Z"></path></svg>
}

templ repositoryIcon() {
	<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23A11.5 11.5 0 0 1 12 5.8c1.02 0 2.05.14 3 .4 2.3-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.82 1.1.82 2.22v3.3c0 .32.22.69.82.57A12 12 0 0 0 12 0Z"></path></svg>
}
